<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.librarymanagement.controllers.SetupController"
           styleClass="root-dark">
    <VBox styleClass="card" maxWidth="460" spacing="14" alignment="TOP_LEFT">
        <Label text="Welcome" styleClass="title"/>
        <Label text="Create the administrator account for this library. There is no default password."
               wrapText="true" styleClass="muted"/>
        <Label text="Full name" styleClass="field-label"/>
        <TextField fx:id="fullNameField"/>
        <Label text="Username" styleClass="field-label"/>
        <TextField fx:id="usernameField"/>
        <Label text="Password (min. 10 characters, upper, lower, number)" styleClass="field-label"/>
        <PasswordField fx:id="passwordField"/>
        <Label text="Confirm password" styleClass="field-label"/>
        <PasswordField fx:id="confirmField"/>
        <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>
        <Button fx:id="createButton" text="Create administrator" styleClass="primary" onAction="#onCreate"
                maxWidth="Infinity" defaultButton="true"/>
    </VBox>
</StackPane>
